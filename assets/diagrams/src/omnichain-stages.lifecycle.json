  "cards": [
    {
      "dot": "emerald",
      "title": "三件事，别混为一谈",
      "items": [
        "发送成功 ≠ 到账成功 ≠ 质押成功",
        "前一步成功不代表后一步成功",
        "到账后核验收益库份额，不是代币余额"
      ]
    },
    {
      "dot": "cyan",
      "title": "失败不等于丢币",
      "items": [
        "发送失败：当笔回退，资金不动",
        "暂时无法接收：不撤销源链，自动重新投递",
        "落位失败：退回后可重新执行"
      ]
    },
    {
      "dot": "rose",
      "title": "两个例外",
      "items": [
        "接收预算配置过低（极端少见）：已销毁未铸造，滞留待手动恢复",
        "收益库不存在：裸币直转接收人，无份额无票权",
        "收益库就位后可重新发起质押"
      ]
    }
  ]
