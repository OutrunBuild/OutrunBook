  "cards": [
    {
      "dot": "emerald",
      "title": "Three things, don't conflate them",
      "items": [
        "Send success ≠ arrival ≠ stake success",
        "Each stage can succeed or fail on its own",
        "After arrival, verify YieldVault shares, not token balance"
      ]
    },
    {
      "dot": "cyan",
      "title": "Failure does not mean lost funds",
      "items": [
        "Send fails: reverts; no funds move",
        "Can't receive: no rollback; auto redelivery",
        "Placement fails: reverts; only gas is lost"
      ]
    },
    {
      "dot": "rose",
      "title": "Two exceptions",
      "items": [
        "Budget too low (rare): the transfer is burned, not minted; recovery is manual",
        "No YieldVault: bare tokens go to the recipient, no shares or voting power",
        "Restake once the YieldVault exists"
      ]
    }
  ]
