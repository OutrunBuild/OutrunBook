  "cards": [
    {
      "dot": "emerald",
      "title": "Three things, don't conflate them",
      "items": [
        "Send success ≠ arrival success ≠ stake success",
        "One step succeeding does not mean the next will",
        "After arrival, verify YieldVault shares, not token balance"
      ]
    },
    {
      "dot": "cyan",
      "title": "Failure does not mean lost funds",
      "items": [
        "Send fails: transaction reverts, no funds move",
        "Destination temporarily unavailable: source not rolled back, redelivered automatically",
        "Placement fails: reverts, can be retried"
      ]
    },
    {
      "dot": "rose",
      "title": "Two exceptions",
      "items": [
        "Receiving budget too low (extremely rare): burned but not minted, stranded pending manual recovery",
        "No YieldVault: bare tokens go to the recipient, no shares or voting power",
        "Re-initiate the stake once the YieldVault is in place"
      ]
    }
