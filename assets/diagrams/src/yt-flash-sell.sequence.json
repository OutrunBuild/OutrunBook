    ]
  },
  "participants": [
    {
      "id": "user",
      "type": "external",
      "label": "用户",
      "sublabel": "设最低收到下限"
    },
    {
      "id": "pool",
      "type": "database",
      "label": "PT/POL 池",
      "sublabel": "复用流动性"
    },
    {
      "id": "merge",
      "type": "backend",
      "label": "合并",
      "sublabel": "1 PT＋1 YT ＝ 1 POL"
    }
  ],
  "messages": [
    {
      "id": "borrow",
      "from": "user",
      "to": "pool",
      "y": 185,
      "label": "买入 y 个 PT，花 Q 个 POL",
      "note": "这 Q 个 POL 是「借」的",
      "variant": "emphasis"
    },
    {
      "id": "merge-leg",
      "from": "user",
      "to": "merge",
      "y": 235,
      "label": "y 个 PT＋你的 y 个 YT 合并",
      "note": "变回 y 个 POL"
    },
    {
      "id": "repay",
      "from": "user",
      "to": "pool",
      "y": 285,
      "label": "归还 Q 个 POL",
      "variant": "return"
    },
    {
      "id": "receive",
      "from": "pool",
      "to": "user",
      "y": 330,
      "label": "到手 y − Q 个 POL",
      "note": "显示价仅供参考，实际以成交时状态为准",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "收款与保护",
      "items": [
        "卖出设最低收到下限，另可设保护线与过期时限，低于即整笔回滚",
        "报价仅供参考，未超保护线仍按更差成交（MEV／市场变动）",
        "单笔原子执行：要么全部完成，要么分毫不差回滚"
      ]
    },
    {
      "dot": "violet",
      "title": "费用与成交",
      "items": [
        "一次底层交易一次费，按完整 PT 腿规模计（相对本金放大）",
        "受池深度影响，任意数量不保证成交（诚实失败）",
        "费率规则与普通 PT/POL 交易完全一致"
      ]
    },
    {
      "dot": "rose",
      "title": "前置与范围",
      "items": [
        "仅锁定期可用",
        "智能账户会话前置",
        "到手 y − Q 个 POL，Q 越大净得越少"
      ]
    }
  ]
}