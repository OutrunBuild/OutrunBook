          "label": "Fee components and composition",
          "visible": true
        }
      }
    }
  },
  "lanes": [
    {
      "id": "components",
      "label": "Dynamic fee = base fee + three dynamic components"
    },
    {
      "id": "actual",
      "label": "Actual fee = max(dynamic fee, pool-opening decay fee)"
    },
    {
      "id": "exempt",
      "label": "EWVWAP exemption (first trade not exempt)"
    }
  ],
  "nodes": [
    {
      "id": "base",
      "lane": "components",
      "col": 0,
      "type": "backend",
      "width": 96,
      "label": "Base fee",
      "sublabel": "1% floor"
    },
    {
      "id": "adverse",
      "lane": "components",
      "col": 1,
      "type": "backend",
      "width": 110,
      "label": "+ adverse fee",
      "sublabel": "per address; 3s window"
    },
    {
      "id": "vol",
      "lane": "components",
      "col": 3,
      "type": "backend",
      "width": 110,
      "label": "+ volatility fee",
      "sublabel": "per pool"
    },
    {
      "id": "short",
      "lane": "components",
      "col": 5,
      "type": "backend",
      "width": 110,
      "label": "+ short-term fee",
      "sublabel": "above 2%; 15s decay"
    },
    {
      "id": "dyn",
      "lane": "actual",
      "col": 5,
      "type": "backend",
      "width": 110,
      "label": "= dynamic fee",
      "sublabel": "sum of the four"
    },
    {
      "id": "actual",
      "lane": "actual",
      "col": 3,
      "type": "backend",
      "width": 110,
      "label": "Actual fee",
      "sublabel": "cap 100% · fixed"
    },
    {
      "id": "decay",
      "lane": "actual",
      "col": 1,
      "type": "backend",
      "width": 124,
      "label": "Pool-opening fee",
      "sublabel": "50%→1% in 15 min"
    },
    {
      "id": "ewvap",
      "lane": "exempt",
      "col": 3,
      "type": "backend",
      "width": 124,
      "label": "EWVWAP exemption",
      "sublabel": "history + reversal → 1%"
    }
  ],
  "edges": [
    {
      "from": "base",
      "to": "adverse"
    },
    {
      "from": "adverse",
      "to": "vol"
    },
    {
      "from": "vol",
      "to": "short"
    },
    {
      "from": "short",
      "to": "dyn"
    },
    {
      "from": "dyn",
      "to": "actual",
      "fromSide": "left",
      "toSide": "right"
    },
    {
      "from": "decay",
      "to": "actual"
    },
    {
      "from": "ewvap",
      "to": "actual",
      "label": "Exempt: base fee only",
      "variant": "dashed",
      "fromSide": "top",
      "toSide": "bottom",
      "labelAt": [
        430,
        320
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Computing the four components",
      "items": [
        "The adverse impact fee is tracked per address × pool; impacts accumulate within a 3-second window, so order splitting fails",
        "The volatility fee is per pool and rises with volatility; the short-term impact fee is per pool, charging only the portion above 2%",
        "Short-term impact decays over 15 seconds and rapid consecutive impacts stack; total cap 100% · fixed"
      ]
    },
    {
      "dot": "violet",
      "title": "Exemption and floor",
      "items": [
        "EWVWAP: with trade history and a trade pointing back toward equilibrium, all dynamic fees are skipped and only 1% is paid",
        "The first trade (no trade history) is not exempt",
        "If the decay config drops below 1%, the 1% floor still applies"
      ]
    },
    {
      "dot": "amber",
      "title": "Pool-opening decay fee",
      "items": [
        "Starts at 50% by default and decays to 1% within 15 minutes (current defaults, adjustable by the protocol)",
        "Inside the decay window, the EWVWAP exemption takes the higher of the base fee and the current opening fee",
        "The decay curve is a normalized exponential decay"
      ]
    }
  ]
}
