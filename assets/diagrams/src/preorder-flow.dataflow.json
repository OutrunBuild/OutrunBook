  "cards": [
    {
      "dot": "cyan",
      "title": "Capacity and basis",
      "items": [
        "Total preorder capacity = (standard Genesis capital + leverage debt principal) × 70% × protocol-configured ratio",
        "First come, first served; preorder funds themselves do not count toward the capacity base",
        "Ledgered separately; not part of the success check"
      ]
    },
    {
      "dot": "violet",
      "title": "The fee rate is fixed",
      "items": [
        "Fixed 1% settlement fee · fixed, bypassing dynamic fees and elevated pool-opening fees",
        "Still split LP 65% / protocol 35%; not eligible for referral rebate",
        "Public trading cannot jump the queue; the fee rate is fixed, not the price"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure and retention",
      "items": [
        "Genesis below threshold: refunded in full to the preorder record's beneficiary",
        "Cannot execute in full: the entire launch reverts, no partial settlement",
        "Unclaimed amounts during the linear unlock stay reserved and keep accumulating"
      ]
    }
  ]
