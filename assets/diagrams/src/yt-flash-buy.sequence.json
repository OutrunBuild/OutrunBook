{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "买 YT：借 PT → 拆分 → 还 PT（单笔原子交易）",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "assets/diagrams/yt-flash-buy.html",
    "viewBox": [
      820,
      500
    ]
  },
  "participants": [
    {
      "id": "user",
      "type": "external",
      "label": "用户",
      "sublabel": "设最高支付上限"
    },
    {
      "id": "pool",
      "type": "database",
      "label": "PT/POL 池",
      "sublabel": "复用流动性"
    },
    {
      "id": "split",
      "type": "backend",
      "label": "拆分",
      "sublabel": "1 POL ＝ 1 PT＋1 YT"
    }
  ],
  "messages": [
    {
      "id": "borrow",
      "from": "user",
      "to": "pool",
      "y": 185,
      "label": "卖出 y 个 PT，换 R 个 POL",
      "note": "这 y 个 PT 是「借」的，尚未持有",
      "variant": "emphasis"
    },
    {
      "id": "split-leg",
      "from": "user",
      "to": "split",
      "y": 235,
      "label": "凑齐 y 个 POL 去拆分",
      "note": "自己掏的钱＋R → y 个 PT＋y 个 YT"
    },
    {
      "id": "repay",
      "from": "user",
      "to": "pool",
      "y": 285,
      "label": "用拆出的 y 个 PT 归还借款",
      "variant": "return"
    },
    {
      "id": "receive",
      "from": "split",
      "to": "user",
      "y": 330,
      "label": "到手 y 个 YT",
      "note": "实际支付 y − R 个 POL",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "支付与保护",
      "items": [
        "买入设最高支付上限，另可设保护线与过期时限，超出整笔回滚",
        "报价仅供参考，未超保护线仍按更差成交（MEV／市场变动）",
        "不预扣、不退款：上限只是护栏，只拉取实际成本"
      ]
    },
    {
      "dot": "violet",
      "title": "费用与成交",
      "items": [
        "一次底层交易一次费，按完整 PT 腿规模计（相对本金放大）",
        "受池深度影响，任意数量不保证成交（诚实失败）",
        "费率规则与普通 PT/POL 交易完全一致"
      ]
    },
    {
      "dot": "rose",
      "title": "前置与范围",
      "items": [
        "仅锁定期可用",
        "智能账户会话前置",
        "到手 y 个 YT，实际支付 y − R 个 POL"
      ]
    }
  ]
}